# Copy this file to secrets.toml (same folder) and fill in the real values.
# NEVER commit secrets.toml to GitHub — .gitignore already excludes it.
#
# If you're running locally only and don't want to set up Google sign-in,
# you can skip this file entirely — the app falls back to username/password
# automatically when this isn't present or isn't filled in.
#
# If deploying to Streamlit Community Cloud, don't upload this file at all —
# paste its contents into the app's "Secrets" settings in the Streamlit Cloud
# dashboard instead (Settings -> Secrets). See README.md for exact steps.

[auth]
# A random secret used to encrypt the login session cookie.
# Generate your own with:   python3 -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_YOUR_OWN_RANDOM_STRING"

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
client_id = "REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET"

# Google's OIDC discovery document — leave this exactly as-is
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Must exactly match one of the "Authorized redirect URIs" you set in Google
# Cloud Console. For local testing:
#   redirect_uri = "http://localhost:8501/oauth2callback"
# For a deployed Streamlit Community Cloud app:
#   redirect_uri = "https://YOUR-APP-NAME.streamlit.app/oauth2callback"
redirect_uri = "http://localhost:8501/oauth2callback"
